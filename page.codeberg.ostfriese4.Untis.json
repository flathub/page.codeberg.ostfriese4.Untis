{
    "id": "page.codeberg.ostfriese4.Untis",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "untis",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup-commands": [
        "python3 -m compileall --invalidation-mode=unchecked-hash /app"
    ],
    "modules": [
        "pypi.json",
        {
            "name": "untis",
            "builddir": true,
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://codeberg.org/ostfriese4/untis.git",
                    "tag": "v4.3.2",
                    "commit": "89f2de618d7e0826b3f8cc27702863da1b285847",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
